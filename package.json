{
  "name": "caddie-backend-nest",
  "version": "0.4.0",
  "private": false,
  "description": "Backend for shopping app built with NestJS, Kysely and Fastify",
  "keywords": [
    "fastify",
    "kysely",
    "nestjs",
    "nodejs",
    "rest",
    "shopping"
  ],
  "license": "AGPL-3.0-only",
  "author": "Benjamin Fabry",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "check:knip": "knip",
    "check:oxfmt": "oxfmt --check",
    "check:oxlint": "oxlint",
    "db:codegen": "node --env-file-if-exists=.env ./node_modules/kysely-codegen/dist/cli/bin.js --config-file .config/kysely-codegen.config.ts",
    "db:migrate:latest": "node --env-file-if-exists=.env ./node_modules/kysely-ctl/dist/bin.mjs migrate latest",
    "db:migrate:make": "node --env-file-if-exists=.env ./node_modules/kysely-ctl/dist/bin.mjs migrate make",
    "fix:oxfmt": "oxfmt --write",
    "fix:oxlint": "oxlint --fix",
    "format": "npm run fix:oxfmt -- . && npm run fix:oxlint -- .",
    "lint": "npm run check:oxfmt -- . && npm run check:oxlint -- .",
    "start": "nest start --env-file=.env",
    "start:debug": "nest start --watch --debug ${NEST_IP}:${DEBUG_PORT} --env-file=.env",
    "start:dev": "nest start --watch --env-file=.env",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:cov": "vitest run --config ./vitest.config.e2e.ts --coverage",
    "test:debug": "vitest --inspect-brk=0.0.0.0:9230 --no-file-parallelism --config ./vitest.config.e2e.ts",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest --config ./vitest.config.e2e.ts",
    "typecheck": "npm run typecheck:src && npm run typecheck:test",
    "typecheck:src": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "bcrypt": "^6.0.0",
    "fastify": "^5.12.1",
    "kysely": "^0.29.5",
    "kysely-ctl": "^0.21.0",
    "ms": "^2.1.3",
    "pg": "^8.23.0",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "knip": "^6.33.0",
    "kysely-codegen": "^0.20.0",
    "lefthook": "^2.1.12",
    "light-my-request": "^6.6.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11.15.0"
  },
  "allowScripts": {
    "@swc/core": true,
    "bcrypt": true,
    "fsevents": false,
    "lefthook": true,
    "unrs-resolver": true
  }
}
