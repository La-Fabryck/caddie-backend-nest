{
  "name": "caddie-backend-nest",
  "version": "0.6.0",
  "private": false,
  "description": "Backend for shopping app built with NestJS and Kysely",
  "keywords": [
    "kysely",
    "nestjs",
    "nodejs",
    "rest",
    "shopping"
  ],
  "license": "AGPL-3.0-only",
  "author": "Benjamin Fabry",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "check:knip": "knip",
    "check:oxfmt": "oxfmt --check",
    "check:oxlint": "oxlint",
    "db:codegen": "node --env-file-if-exists=.env ./node_modules/kysely-codegen/dist/cli/bin.js --config-file .config/kysely-codegen.config.ts",
    "db:migrate:latest": "node --env-file-if-exists=.env ./node_modules/kysely-ctl/dist/bin.mjs migrate latest",
    "db:migrate:make": "node --env-file-if-exists=.env ./node_modules/kysely-ctl/dist/bin.mjs migrate make",
    "fix:oxfmt": "oxfmt --write",
    "fix:oxlint": "oxlint --fix",
    "format": "npm run fix:oxfmt -- . && npm run fix:oxlint -- .",
    "lint": "npm run check:oxfmt -- . && npm run check:oxlint -- .",
    "start": "nest start --env-file=.env",
    "start:debug": "nest start --watch --debug ${NEST_IP}:${DEBUG_PORT} --env-file=.env",
    "start:dev": "nest start --watch --env-file=.env",
    "start:prod": "node dist/main",
    "test": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run",
    "test:cov": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts --coverage",
    "test:debug": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs --inspect-brk=0.0.0.0:9230 --no-file-parallelism --config ./vitest.config.e2e.ts",
    "test:e2e": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts",
    "test:watch": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs --config ./vitest.config.e2e.ts",
    "typecheck": "npm run typecheck:src && npm run typecheck:test",
    "typecheck:src": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-node": "^12.3.2",
    "bcrypt": "^6.0.0",
    "cookie": "0.7.2",
    "kysely": "^0.29.7",
    "kysely-ctl": "^0.22.0",
    "ms": "^2.1.3",
    "pg": "^8.23.1",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "knip": "^6.43.0",
    "kysely-codegen": "^0.20.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11.15.0"
  },
  "allowScripts": {
    "@swc/core": true,
    "bcrypt": true,
    "fsevents": false,
    "lefthook": true,
    "unrs-resolver": true
  }
}
