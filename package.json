{
  "name": "caddie-backend-nest",
  "version": "0.4.0",
  "private": false,
  "description": "Backend for shopping app built with NestJS, Kysely and Fastify",
  "keywords": [
    "fastify",
    "kysely",
    "nestjs",
    "nodejs",
    "rest",
    "shopping"
  ],
  "license": "AGPL-3.0-only",
  "author": "Benjamin Fabry",
  "scripts": {
    "build": "nest build",
    "check:knip": "knip",
    "check:oxfmt": "oxfmt --check -c oxfmt.config.mts",
    "check:oxlint": "oxlint -c oxlint.config.mts",
    "db:codegen": "node --env-file-if-exists=.env ./node_modules/kysely-codegen/dist/cli/bin.js --config-file .config/kysely-codegen.config.ts",
    "db:migrate:latest": "node --env-file-if-exists=.env ./node_modules/kysely-ctl/dist/bin.mjs migrate latest",
    "db:migrate:make": "node --env-file-if-exists=.env ./node_modules/kysely-ctl/dist/bin.mjs migrate make",
    "fix:oxfmt": "oxfmt --write -c oxfmt.config.mts",
    "fix:oxlint": "oxlint --fix -c oxlint.config.mts",
    "format": "npm run fix:oxfmt -- . && npm run fix:oxlint -- .",
    "lint": "npm run check:oxfmt -- . && npm run check:oxlint -- .",
    "start": "nest start --env-file=.env",
    "start:debug": "nest start --watch --debug ${NEST_IP}:${DEBUG_PORT} --env-file=.env",
    "start:dev": "nest start --watch --env-file=.env",
    "start:prod": "node dist/src/main.js",
    "test": "jest",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest.e2e.json --coverage",
    "test:debug": "node --inspect=0.0.0.0:9230 --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --config ./test/jest.e2e.json --runInBand --watchAll",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest.e2e.json",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest.e2e.json --runInBand --watchAll",
    "typecheck": "npm run typecheck:src && npm run typecheck:test",
    "typecheck:src": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.11.3",
    "kysely": "^0.29.5",
    "kysely-ctl": "^0.21.0",
    "ms": "^2.1.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "jest": "^30.4.2",
    "knip": "^6.32.2",
    "kysely-codegen": "^0.20.0",
    "lefthook": "^2.1.10",
    "light-my-request": "^6.6.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s?$": [
        "@swc/jest"
      ]
    }
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11.15.0"
  },
  "allowScripts": {
    "@swc/core": true,
    "bcrypt": true,
    "fsevents": false,
    "lefthook": true,
    "unrs-resolver": true
  }
}
