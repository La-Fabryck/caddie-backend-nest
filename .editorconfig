# https://editorconfig.org
# Shared layout for editors and Oxfmt (indent, EOL, line length). Oxfmt-only options live in `oxfmt.config.ts`.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 140

# Prose: no wrap ruler (soft-wrap in the editor). Trailing space stays trimmed from [*];
# two-space Markdown hard breaks are a footgun — use a trailing `\` or `<br>` if needed.
[*.md]
max_line_length = off
