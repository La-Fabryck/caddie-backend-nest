# Dependencies (reinstalled in image)
node_modules

# Build output (rebuilt in image)
dist

# Git
.git
.gitignore
.dockerignore

# IDE / editor
.cursor
.vscode
.idea
*.swp
*.swo
*~
*.http

# Env and secrets (e2e Dockerfile copies docker/app/e2e/.env.e2e)
.env
.env.*
!docker/app/e2e/.env.e2e

# Test artifacts (not test/ — e2e image needs it)
coverage
.nyc_output
jest.config.*

# Lint / format (host-only)
oxfmt.config.*
oxlint.config.*
.editorconfig

# Git hooks
lefthook.yml
lefthook-local.yml

# Host toolchain
.node-version

# Docs
*.md
docs

# Image build scaffolding (not COPY'd into the image)
Makefile
Dockerfile*
compose*.yml
docker-compose*
*.sh

# Logs and OS
logs
*.log
.DS_Store
Thumbs.db
