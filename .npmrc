# Disallow git deps (github:/git+/owner/repo, etc.)
allow-git=none

# Disallow remote URL tarball deps
allow-remote=none

# Disallow local tarball (file:*.tgz) deps
allow-file=none

# Disallow local directory (file:./path) deps
allow-directory=none

# Refuse packages that declare an incompatible Node engine
engine-strict=true

# Fail install if a dep has scripts not listed in allowScripts
strict-allow-scripts=true

# Only install versions published at least 1 day ago
min-release-age=1
